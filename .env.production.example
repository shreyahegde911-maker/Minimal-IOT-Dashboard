# Copy to .env for the production Compose stack. Never commit .env.
# Generate both values locally; do not reuse the development token.
API_TOKEN=replace_with_a_long_random_ingestion_token
DB_PASSWORD=replace_with_a_long_random_database_password

# Public dashboard port for a direct demo. For production, put the frontend
# behind a TLS-enabled reverse proxy or a hosting provider's HTTPS edge.
DASHBOARD_PORT=8080
SIMULATION_INTERVAL_SEC=3
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120

# Optional notification providers. Leave empty unless intentionally configured.
Z_SCORE_THRESHOLD=3.0
ROLLING_WINDOW_SIZE=60
TEMP_HIGH_THRESHOLD=35.0
ALERT_COOLDOWN_SECONDS=60
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
